+/* ---- bt3 port (Tenkaichi3Decomp): many draws with the current program and state, each with its own vertex
+   uniforms (the whole default uniform block) and its own indices, kept in the bound element array buffer ---- */
+GLboolean vglFastPrepare(GLenum type) {
+	if (cur_program == 0)
+		return GL_FALSE;
+	vbo *gpu_buf = (vbo *)cur_vao->index_array_unit;
+	if (!gpu_buf)
+		return GL_FALSE;
+	scene_reset();
+	dirty_shader_vert_unifs = GL_TRUE;
+	GLboolean r = _glDrawElements_CustomShadersIMPL((uint16_t *)gpu_buf->ptr, 3, 0, 0, type == GL_UNSIGNED_INT ? SCE_GXM_INDEX_SOURCE_INDEX_32BIT : SCE_GXM_INDEX_SOURCE_INDEX_16BIT);
+	gpu_buf->last_frame = vgl_framecount;
+	return r;
+}
+
+/* bt3 port: the vertex data of the draws that follow `bytes` further on in their buffers (the indices count from
+   there): the streams vglFastPrepare set up, moved. The attribute offsets of a vertex layout are 16 bits, so a
+   buffer's far part cannot be reached through glVertexAttribPointer's offset. */
+void vglFastVertexBase(uint32_t bytes) {
+	for (int i = 0; i < bt3_stream_n; i++) {
+		if (bt3_stream_data[i])
+			sceGxmSetVertexStream(gxm_context, i, (const uint8_t *)bt3_stream_ptr[i] + bytes);
+	}
+}
+
+void vglFastDraw(GLenum type, uint32_t offset, uint32_t count, const void *vunif, uint32_t size) {
+	vbo *gpu_buf = (vbo *)cur_vao->index_array_unit;
+	void *buffer = vglReserveVertexUniformBuffer(size);
+	vgl_fast_memcpy(buffer, vunif, size);
+	sceGxmDraw(gxm_context, SCE_GXM_PRIMITIVE_TRIANGLES, type == GL_UNSIGNED_INT ? SCE_GXM_INDEX_FORMAT_U32 : SCE_GXM_INDEX_FORMAT_U16, (uint8_t *)gpu_buf->ptr + offset, count);
+	dirty_shader_vert_unifs = GL_TRUE;
+}
+
+void vglFastDrawPtr(GLenum type, const void *idx, uint32_t count, const void *vunif, uint32_t size) {
+	void *buffer = vglReserveVertexUniformBuffer(size);
+	vgl_fast_memcpy(buffer, vunif, size);
+	sceGxmDraw(gxm_context, SCE_GXM_PRIMITIVE_TRIANGLES, type == GL_UNSIGNED_INT ? SCE_GXM_INDEX_FORMAT_U32 : SCE_GXM_INDEX_FORMAT_U16, idx, count);
+	dirty_shader_vert_unifs = GL_TRUE;
+}
+
+uint32_t vglFastVertUniformSize(GLuint prog) {
+	if (prog == 0)
+		return 0;
+	program *p = &progs[prog - 1];
+	return p->vshader ? p->vshader->unif_buf_size : 0;
+}
+
+int vglFastUniformOffset(GLuint prog, GLint location) {
+	if (location == -1 || location == 0 || prog == 0)
+		return -1;
+	program *p = &progs[prog - 1];
+#ifdef STRICT_UNIFORMS_COMPLIANCE
+	uint32_t offs = 0;
+	uniform *u = (uniform *)get_uniform_from_ptr(location, &offs);
+#else
+	uniform *u = (uniform *)get_uniform_from_ptr(location, NULL);
+#endif
+	if (!u->vptr || !p->unif_vbuffer)
+		return -1;
+	return (int)((uint8_t *)u->vptr - (uint8_t *)p->unif_vbuffer);
+}
