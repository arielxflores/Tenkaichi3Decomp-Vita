+/* to `level`, the cursor on plate `value` (level 1: on item `value`, on its page) */
+static void Option_VitaSetLevel(s32 level, s32 value) {
+    sVitaSetLevel = level;
+    sVitaGameArmed = 0;
+    if (level == 1) {
+        sVitaItem1 = value;
+        value %= 4;
+    }
+    Vita_OptionCaptions(level == 2 || level == 3 ? 0 : level == 7 || level == 9 || level == 10 || (level == 1 && sVitaItem1 >= 4) ? 6 : 1);
+    Option_DimPickers();
