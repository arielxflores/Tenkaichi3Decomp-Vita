+/* level 1: the cursor to `item` (the page turned when it is on the other one) */
+static void Option_VitaL1Move(s32 item) {
+    s32 page = sVitaItem1 / 4;
+    OPT_PLATE(OPT_CLIP_PICK, "fl_off_start");
+    sVitaItem1 = item;
+    if (item / 4 != page) {
+        Vita_OptionCaptions(item >= 4 ? 6 : 1);
