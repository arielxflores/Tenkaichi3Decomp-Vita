+            o[1] = 0xE;                       /* A+D */
+            o[2] = g[2]; o[3] = 0x00;          /* PRIM */
+            o[4] = g[3]; o[5] = (g[1] >> 4) & 0xF; /* TEX0_1 or TEX0_2, as the triangle has it */
+            o[6] = g[10]; o[7] = 0x01;         /* RGBAQ of its third corner */
+            o[8] = g[11]; o[9] = 0x02;         /* ST */
+            dst += 5 * 16;
+        }
+        p = q;
+    }
+    return dst;
+}
